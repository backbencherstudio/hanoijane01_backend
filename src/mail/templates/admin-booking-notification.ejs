<!DOCTYPE html>
<html>
<head><meta charset="utf-8" /></head>
<body style="font-family: Arial, sans-serif; background: #f7fafc; padding: 20px; color: #333;">
  <div style="max-width: 640px; margin: auto; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 30px;">
    <h2 style="color: #2b6cb0; margin-top: 0;">🎉 New Paid Booking Received</h2>

    <p>A new booking has been paid and is awaiting review/approval.</p>

    <div style="background: #f7fafc; padding: 15px; border-left: 4px solid #3182ce; border-radius: 5px; margin: 20px 0;">
      <p style="margin: 5px 0;"><strong>Booking ID:</strong> <%= bookingId %></p>
      <p style="margin: 5px 0;"><strong>Name:</strong> <%= userName %></p>
      <p style="margin: 5px 0;"><strong>Company:</strong> <%= companyName %></p>
      <p style="margin: 5px 0;"><strong>Email:</strong> <a href="mailto:<%= userEmail %>"><%= userEmail %></a></p>
      <p style="margin: 5px 0;"><strong>Phone:</strong> <%= phoneNumber %></p>
      <hr style="border: 0.5px solid #e2e8f0; margin: 12px 0;" />
      <% if (standNumber) { %><p style="margin: 5px 0;"><strong>Stand:</strong> <%= standNumber %></p><% } %>
      <% if (hall) { %><p style="margin: 5px 0;"><strong>Hall:</strong> <%= hall %></p><% } %>
      <% if (category) { %><p style="margin: 5px 0;"><strong>Category:</strong> <%= category %></p><% } %>
      <% if (event) { %><p style="margin: 5px 0;"><strong>Event:</strong> <%= event %></p><% } %>
      <% if (totalAmount !== '') { %>
        <p style="margin: 5px 0;"><strong>Amount Paid:</strong> <%= currencySymbol %><%= totalAmount %></p>
      <% } %>
      <% if (paidAt) { %><p style="margin: 5px 0;"><strong>Paid At:</strong> <%= paidAt %></p><% } %>
    </div>

    <p style="font-size: 13px; color: #718096;">Please log in to the admin panel to review and approve this booking.</p>
    <hr style="border: 0.5px solid #e2e8f0; margin: 20px 0;" />
    <p style="font-size: 11px; color: #cbd5e0;">© <%= year %> <%= appName %></p>
  </div>
</body>
</html>