<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Booking Pending</title>
</head>
<body style="font-family: Arial, sans-serif; background: #f7fafc; padding: 20px; color: #333;">
  <div style="max-width: 600px; margin: auto; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 30px;">
    <h2 style="color: #2b6cb0; margin-top: 0;">Booking Received — Payment Pending</h2>

    <p>Hello <strong><%= name %></strong>,</p>

    <p>
      Thank you for your booking at <strong><%= appName %></strong>. Your booking
      has been created and is currently <strong>pending payment</strong>.
    </p>

    <div style="background: #f7fafc; padding: 15px; border-left: 4px solid #3182ce; border-radius: 5px; margin: 20px 0;">
      <p style="margin: 5px 0;"><strong>Booking ID:</strong> <%= bookingId %></p>
      <% if (standNumber) { %><p style="margin: 5px 0;"><strong>Stand:</strong> <%= standNumber %></p><% } %>
      <% if (hall) { %><p style="margin: 5px 0;"><strong>Hall:</strong> <%= hall %></p><% } %>
      <% if (category) { %><p style="margin: 5px 0;"><strong>Category:</strong> <%= category %></p><% } %>
      <% if (event) { %><p style="margin: 5px 0;"><strong>Event:</strong> <%= event %></p><% } %>
      <% if (totalAmount !== '') { %>
        <p style="margin: 5px 0;"><strong>Total Amount:</strong> <%= currencySymbol %><%= totalAmount %></p>
      <% } %>
    </div>

    <% if (paymentUrl) { %>
      <p>Please complete your payment to confirm your booking:</p>
      <p style="text-align: center; margin: 25px 0;">
        <a href="<%= paymentUrl %>"
           style="display: inline-block; padding: 12px 24px; background-color: #3182ce; color: #ffffff; text-decoration: none; border-radius: 5px; font-weight: bold;">
          Complete Payment
        </a>
      </p>
    <% } else { %>
      <p>Please log in to your account and complete the payment to confirm your booking.</p>
    <% } %>

    <p style="font-size: 13px; color: #718096; margin-top: 25px;">
      If you have any questions, please contact our support team.
    </p>

    <p style="font-size: 13px; color: #718096;">
      Regards,<br/>
      <strong><%= appName %></strong> Team
    </p>

    <hr style="border: 0.5px solid #e2e8f0; margin: 20px 0;" />
    <p style="font-size: 12px; color: #a0aec0;">This is an automated message — please do not reply.</p>
    <p style="font-size: 11px; color: #cbd5e0;">© <%= year %> <%= appName %></p>
  </div>
</body>
</html>